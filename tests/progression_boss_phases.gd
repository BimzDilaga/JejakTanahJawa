extends Node2D
var failures := 0
func _ready() -> void: _run.call_deferred()
func frames(count: int) -> void:
	for i in range(count): await get_tree().physics_frame
func check(ok: bool, message: String) -> void:
	if not ok:
		failures += 1
		push_error(message)
func _run() -> void:
	preload("res://tests/test_session.gd").isolate("progression_boss_phases.gd")
	GameState.reset_campaign()
	check(GameState.upgrade_points==600 and GameState.player_max_health()==3,"Demo starts at 600 points and three hearts")
	for attribute in GameState.upgrade_levels: check(GameState.upgrade_levels[attribute]==0,"All demo attribute levels start at zero")
	for expected in [2,4,8]:
		check(GameState.upgrade_cost("heart")==expected and GameState.buy_upgrade("heart"),"Heart upgrade follows exponential costs")
	check(GameState.player_max_health()==6 and not GameState.buy_upgrade("heart") and GameState.upgrade_points==586,"Heart upgrades stop exactly at six")
	for expected in [2,4,8,16]:
		check(GameState.upgrade_cost("attack")==expected and GameState.buy_upgrade("attack"),"Attack level cost is 2,4,8,16")
	GameState.reset_campaign()
	check(not GameState.award_upgrade_defeat() and not GameState.award_upgrade_defeat() and GameState.upgrade_points==600,"Two defeats do not award an upgrade point")
	check(GameState.award_upgrade_defeat() and GameState.upgrade_points==601 and GameState.upgrade_defeats==0,"Every third defeat awards exactly one point")
	var floor_body := StaticBody2D.new()
	var collision := CollisionShape2D.new()
	var shape := RectangleShape2D.new()
	shape.size = Vector2(4000,100)
	collision.shape = shape
	floor_body.position = Vector2(1500,620)
	floor_body.add_child(collision)
	add_child(floor_body)
	var player: CharacterBody2D = load("res://player.tscn").instantiate()
	player.position = Vector2(400,570)
	add_child(player)
	await frames(6)
	check(player.health==3 and player.max_health==3,"Player reads the new base health")
	player.perform_attack()
	check(is_equal_approx(player.stamina,185),"A swing consumes stamina once")
	await frames(10)
	player.perform_parry()
	check(player.stamina<=175.01,"Parry consumes stamina")
	await frames(65)
	check(player.stamina>175,"Stamina recovers while standing idle")
	player.reset_health()
	player.stamina = 50
	var before_walk: float = player.position.x
	Input.action_press("move_right")
	await frames(30)
	check(player.stamina>=98 and player.position.x>before_walk+50,"Walking restores stamina at 100 per second")
	player.stamina = 50
	Input.action_press("sprint")
	await frames(30)
	check(player.stamina>=98 and player.velocity.x>=player.SPEED,"Running also restores stamina at the full rate")
	Input.action_release("move_right")
	Input.action_release("sprint")
	player.reset_health()
	Input.action_press("jump")
	await frames(2)
	Input.action_release("jump")
	check(player.stamina<=180.01 and player.velocity.y<0,"Jump consumes stamina")
	await frames(65)
	player.stamina = 0
	player.perform_attack()
	check(not player.is_attacking and not player.perform_parry(),"Exhausted stamina blocks attack and parry")
	player.queue_free()
	floor_body.queue_free()
	await frames(4)
	for kind in ["buto","banaspati"]:
		GameState.boss_trial_kind = kind
		var arena: Node = load("res://boss_trial.tscn").instantiate()
		add_child(arena)
		await frames(70)
		check(arena.boss.max_health==(72 if kind=="buto" else 56),"HP per phase doubles for "+kind)
		check(arena.hud.find_child("StaminaMeter",true,false).position.y<arena.hud.find_child("StanceMeter",true,false).position.y,"Stamina sits below hearts and above stance")
		arena.player.position = Vector2(600,570)
		arena.boss.position = Vector2(740,570)
		arena.boss.facing = -1
		arena.boss.attack = {"animation":"heavy","heavy":true,"effect":"melee"}
		arena.boss._strike()
		check(arena.player.health==1 and arena.player.velocity.x<=-379,"Boss heavy applies damage and outward knockback")
		await frames(8)
		check(arena.player.position.x<570,"Knockback creates visible displacement")
		arena.player.reset_health()
		arena.boss.take_damage(999,arena.player.position.x)
		check(not arena.boss.dead and arena.boss.health==0 and arena.phase_camera_locked and not arena.player.controls_enabled and not GameState.ending_started,"First bar depletion starts a camera-locked knockdown, not victory")
		check(not arena.boss.take_damage(1,0),"Transition cannot be damaged or skipped")
		await frames(60)
		check(arena.boss.state=="phase_hold" and absf(arena.camera.position.x-arena.boss.position.x)<15,"Camera centers on the fallen boss")
		await frames(110)
		check(arena.boss.state=="phase_hold","Final fallen pose remains held for two seconds")
		await frames(12)
		check(arena.boss.state=="phase_rise","Recovery reverses the fallen animation")
		await frames(60)
		check(arena.boss.phase==2 and arena.boss.health==arena.boss.max_health and arena.player.controls_enabled and not arena.phase_camera_locked,"Phase two refills health and returns camera/control")
		check(arena.boss.tempo()>1 and arena.boss._windup()<float(arena.boss.tuning.heavy_windup),"Phase two has a faster tempo")
		arena.boss.take_damage(999,arena.player.position.x)
		check(arena.boss.dead and arena.stage==arena.Stage.COMPLETE,"Only final bar defeat wins")
		await frames(80)
		check(arena.overlay.visible and arena.boss.sprite.frame==arena.boss.sprite.sprite_frames.get_frame_count("death")-1,"Final defeat animation precedes the result panel")
		arena._retry_trial()
		await frames(70)
		check(arena.boss.phase==1 and not arena.phase_camera_locked and arena.boss.health==arena.boss.max_health,"Retry starts from phase one without stale cinematic state")
		arena.queue_free()
		await frames(4)
	print("PROGRESSION_BOSS_PHASES failures=",failures)
	get_tree().quit(0 if failures==0 else 1)
